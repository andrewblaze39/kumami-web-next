rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /research_articles/{document} {
      allow read: if true;  // Allow public read access

      // Allow create for admins, superadmins, and newsresearchadmins
      allow create: if isAdmin() || isNewsResearchAdmin();

      // Allow update for admins, superadmins, and newsresearchadmins
      // Regular admins and newsresearchadmins can update drafts
      // Only superadmins can publish (change status from draft to published)
      allow update: if isAdmin() || isNewsResearchAdmin() ||
                    (isSuperAdmin() ||
                     // Regular admins can only update if not changing status to published
                     (resource.data.status == 'draft' &&
                      (!('status' in request.resource.data) || request.resource.data.status == 'draft')));

      // Allow delete for admins, superadmins, and newsresearchadmins
      allow delete: if isAdmin() || isNewsResearchAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;  // Allow public read access

      // Allow create for admins, superadmins, newsresearchadmins, and newsdrafters (draft-only)
      allow create: if isAdmin() || isNewsResearchAdmin() ||
                    (isNewsDrafter() && request.resource.data.status == 'draft');

      // Allow update for admins, superadmins, and newsresearchadmins
      // Regular admins and newsresearchadmins can update drafts
      // Only superadmins can publish (change status from draft to published)
      allow update: if isAdmin() || isNewsResearchAdmin() ||
                    (isSuperAdmin() ||
                     // Regular admins can only update if not changing status to published
                     (resource.data.status == 'draft' &&
                      (!('status' in request.resource.data) || request.resource.data.status == 'draft')) ||
                     // News drafters can only update drafts and cannot change status
                     (isNewsDrafter() && resource.data.status == 'draft' &&
                      (!('status' in request.resource.data) || request.resource.data.status == 'draft')));

      // Allow delete for admins, superadmins, newsresearchadmins, and newsdrafters (draft-only)
      allow delete: if isAdmin() || isNewsResearchAdmin() ||
                    (isNewsDrafter() && resource.data.status == 'draft');
    }

    match /blogs/{blogId} {
      allow read: if true;  // Allow public read access

      // Allow create for admins, superadmins, and newsresearchadmins
      allow create: if isAdmin() || isNewsResearchAdmin();

      // Allow update for admins, superadmins, and newsresearchadmins
      // Regular admins and newsresearchadmins can update drafts
      // Only superadmins can publish (change status from draft to published)
      allow update: if isAdmin() || isNewsResearchAdmin() ||
                    (isSuperAdmin() ||
                     // Regular admins can only update if not changing status to published
                     (resource.data.status == 'draft' &&
                      (!('status' in request.resource.data) || request.resource.data.status == 'draft')));

      // Allow delete for admins, superadmins, and newsresearchadmins
      allow delete: if isAdmin() || isNewsResearchAdmin();
    }

    match /featured/{featuredId} {
      allow read: if true;  // Allow public read access to featured articles

      // Allow create for admins, superadmins, and specialized admins
      allow create: if isAdmin() || isNewsResearchAdmin() || isGamesAdmin();

      // Allow update for admins, superadmins, and specialized admins
      allow update: if isAdmin() || isNewsResearchAdmin() || isGamesAdmin();

      // Allow delete for admins, superadmins, and specialized admins
      allow delete: if isAdmin() || isNewsResearchAdmin() || isGamesAdmin();
    }

    // YouTube Shorts - readable by all, writable by admins
    match /youtube_shorts/{shortId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /marketAnalysis/{document} {
      // Pro content (Andrew, 11 Oct 2026): active Pro subscribers, plus the roles that author it.
      allow read: if request.auth != null
        && (isProUser() || isAdmin() || isNewsResearchAdmin() || isMarketAnalysisAdmin());

      // Allow create for admins, newsresearchadmins, and marketanalysisadmins
      allow create: if isAdmin() || isNewsResearchAdmin() || isMarketAnalysisAdmin();

      // Allow update for admins, newsresearchadmins, and marketanalysisadmins
      allow update: if isAdmin() || isNewsResearchAdmin() || isMarketAnalysisAdmin();

      // Allow delete for admins, newsresearchadmins, and marketanalysisadmins
      allow delete: if isAdmin() || isNewsResearchAdmin() || isMarketAnalysisAdmin();
    }

    // Partner articles for Partner Portal
    match /partner_articles/{articleId} {
      // Public read access for Partner Portal
      allow read: if true;

      // Allow create for admins and news/research admins
      allow create: if isAdmin() || isNewsResearchAdmin();

      // Allow update for admins, superadmins, and newsresearchadmins
      // Regular admins and newsresearchadmins can update drafts
      // Only superadmins can publish (change status from draft to published)
      allow update: if isAdmin() || isNewsResearchAdmin() ||
                    (isSuperAdmin() ||
                     (resource.data.status == 'draft' &&
                      (!('status' in request.resource.data) || request.resource.data.status == 'draft')));

      // Allow delete for admins, superadmins, and newsresearchadmins
      allow delete: if isAdmin() || isNewsResearchAdmin();
    }

    match /app_config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // Allow admin users full access
    function isAdmin() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null &&
             (user.isAdmin == true || user.role == 'admin' || user.role == 'superadmin');
    }

    // Check if user is a superadmin
    function isSuperAdmin() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && user.role == 'superadmin';
    }

    // Check if user is a games admin
    function isGamesAdmin() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && user.role == 'gamesadmin';
    }

    // Check if user is a news and research admin
    function isNewsResearchAdmin() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && user.role == 'newsresearchadmin';
    }

    // Check if user is a news drafter (draft-only permissions)
    function isNewsDrafter() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && user.role == 'newsdrafter';
    }

    // Fields only the server (Admin SDK) may set on users/{uid}: Pro, billing,
    // referral and chat-room state (/api/v1 routes + webhooks; spec v1.13 Pro §21–23).
    function PRIVILEGED_USER_FIELDS() {
      return ['proUntil', 'proSource', 'proGrantedBy', 'proGrantedAt', 'proRemovedBy', 'proRemovedAt',
              'subscriptionId', 'subscriptionStatus', 'plan', 'cancelAtPeriodEnd', 'firstPaidAt',
              'stripeCustomerId', 'stripeSubscriptionId',
              'referralCode', 'referralCount', 'referralRewards', 'referralBalanceCents', 'referredBy',
              'activeChatRoomId'];
    }

    // The only users/{uid} fields the owner may change from the app (allowlist —
    // everything else, incl. role/isAdmin/isPremium and all billing fields, is server-only).
    function OWNER_EDITABLE_USER_FIELDS() {
      return ['displayName', 'photoURL', 'email', 'createdAt', 'updatedAt',
              'cryptoPortfolio', 'lastPortfolioScan'];
    }

    // Active Kumami Pro subscriber: isPremium and, for a time-limited grant
    // (/admin/subscriptions), the end date `proUntil` hasn't passed. Mirrors src/lib/pro.ts.
    function isProUser() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null
        && user.get('isPremium', false) == true
        && (user.get('proUntil', null) == null || user.proUntil > request.time);
    }

    // Check if user is a market analysis admin
    function isMarketAnalysisAdmin() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return request.auth != null && user.role == 'marketanalysisadmin';
    }

    // Alpha Room messages
    match /alphaRoom/{messageId} {
      // Pro content (Andrew, 11 Oct 2026): active Pro subscribers and admins only.
      allow read: if request.auth != null && (isProUser() || isAdmin());

      // Allow create, update, delete for admins and superadmins
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // Users collection rules
    match /users/{userId} {
      // Users can read their own document, superadmins can read all user documents
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      // Users can create their own document — always as a plain, unsubscribed user
      // (QA 10 Oct 2026: a self-created doc could carry role/isPremium).
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('role', 'user') == 'user'
        && request.resource.data.get('isPremium', false) == false
        && request.resource.data.get('isAdmin', false) == false
        && !request.resource.data.keys().hasAny(PRIVILEGED_USER_FIELDS());
      // Owners may edit only their profile fields (allowlist). Pro, billing and
      // referral fields are written server-side only (Admin SDK: /api/v1 routes,
      // payment webhooks, /api/admin/subscription). Cancelling goes through
      // POST /api/v1/subscription/cancel, which cancels in Stripe (v1.13).
      // Superadmins may change another user's role (Role Management).
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(OWNER_EDITABLE_USER_FIELDS())) ||
        (isSuperAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']))
      );
      // Only admins can delete user docs
      allow delete: if isAdmin();

      // Education progress — users can read/write their own progress
      match /education_progress/{levelId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Referral codes — server-only (created by GET /api/v1/referral/me, checked by
    // GET /api/v1/referral/validate). No client reads: owners would leak.
    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // Legacy CRA referral records (no longer written). Read-only for the two parties.
    match /referrals/{referralId} {
      allow read: if request.auth != null &&
                (resource.data.referrerId == request.auth.uid ||
                 resource.data.refereeId == request.auth.uid);
      allow write: if false;
    }

    // Referral rewards (one per new user) + the balance ledger — server-only writes;
    // each party may read their own (spec v1.13 Pro §22).
    match /referral_rewards/{refereeUid} {
      allow read: if request.auth != null &&
                (resource.data.referrerId == request.auth.uid || resource.data.refereeId == request.auth.uid);
      allow write: if false;
    }
    match /referral_ledger/{entryId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Payments, checkout orders — server-only writes; owner reads (spec v1.13 Pro §21).
    match /payments/{paymentId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /checkout_orders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    // webhook_events: no rule → default deny (server-only).

    // Subscriptions collection rules
    match /subscriptions/{subscriptionId} {
      // Written server-side only (payment webhooks, /api/admin/subscription); owner reads.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    match /games/{gamesId} {
      allow read: if true;  // Allow public read access

      // Allow create for admins, superadmins, and gamesadmins
      allow create: if isAdmin() || isGamesAdmin();

      // Allow update for admins, superadmins, and gamesadmins
      // Regular admins and gamesadmins can update drafts
      // Only superadmins can publish (change status from draft to published)
      allow update: if isAdmin() || isGamesAdmin() ||
                    (isSuperAdmin() ||
                     // Regular admins can only update if not changing status to published
                     (resource.data.status == 'draft' &&
                      (!('status' in request.resource.data) || request.resource.data.status == 'draft')));

      // Allow delete for admins, superadmins, and gamesadmins
      allow delete: if isAdmin() || isGamesAdmin();
    }

    // Shared dropdown options for games (genres, networks, platforms, categories)
    match /gameDropdownOptions/{optionId} {
      // Any authenticated user can read options
      allow read: if request.auth != null;

      // Only admins or games admins can manage options
      allow create, update, delete: if isAdmin() || isGamesAdmin();
    }

    match /education_articles/{articleId} {
      allow read: if true;  // Allow public read access

      // Allow create, update, delete for admins and superadmins
      allow create, update, delete: if isAdmin();
    }

    // Homepage partners collection
    match /homepage_partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // All partners collection
    match /all_partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // Legacy partners collection (keep for backward compatibility)
    match /partners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // Legacy crypto orders (replaced by checkout_orders in v1.13) — closed.
    match /pendingCryptoPayments/{document} {
      allow read, write: if false;
    }

    // Reels collection for Instagram/embeddable content
    match /reels/{reelId} {
      allow read: if true;  // Allow public read access

      // Allow create, update, delete for admins, superadmins, and newsresearchadmins
      allow create, update, delete: if isAdmin() || isNewsResearchAdmin();
    }

    // Users' chatrooms and messages - users can read their own, backend writes
    match /users/{userId}/chatrooms/{chatRoomId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Pro dashboard content collections (pro_research, pro_airdrops,
    // pro_calendar, pro_events, ...). Admin-authored content shown on the Pro
    // dashboard: readable by active Pro subscribers and admins only (QA 10 Oct 2026:
    // this used to be public, even logged out), writes restricted to admins.
    // Naming any new Pro collection `pro_*` means NO rules change is needed —
    // this single rule covers it. (Per-user Pro state like follows/alerts lives
    // under users/{uid}/... instead, covered by the users rules below.)
    match /{proCollection}/{docId} {
      allow read: if proCollection.matches('pro_.*') && request.auth != null && (isProUser() || isAdmin());
      allow create, update, delete: if proCollection.matches('pro_.*') && isAdmin();
    }

    // Per-user Pro dashboard state: follows, custom alerts, manual watchlist,
    // and which event questions the user has upvoted. Only the owner can touch it.
    match /users/{userId}/pro/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Live-event audience Q&A. Pro subscribers can ask a question and upvote;
    // only admins can remove. Lives under the (admin-authored) pro_events doc.
    match /pro_events/{eventId}/questions/{questionId} {
      allow read: if request.auth != null && (isProUser() || isAdmin());
      // Subscribers may ask; validate the payload (non-empty, capped length,
      // starts at one vote) so the field can't be abused.
      allow create: if request.auth != null && isProUser()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 280
                    && request.resource.data.votes == 1;
      // Upvote only: the single allowed change is incrementing votes by exactly 1.
      allow update: if request.auth != null && isProUser()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
                    && request.resource.data.votes == resource.data.votes + 1;
      allow delete: if isAdmin();
    }

    // Default deny-all rule (must come last)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
